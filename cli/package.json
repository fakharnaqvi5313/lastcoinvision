{
  "name": "create-lcv-app",
  "version": "0.1.0",
  "description": "Scaffolds a LastcoinVision (LCV) dApp from a starter template that runs against a devnet out of the box.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-lcv-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
