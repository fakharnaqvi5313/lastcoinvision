# BIP-39 mnemonic for the funded faucet account. Required. Devnet/testnet only —
# never use a mainnet-funded mnemonic here.
FAUCET_MNEMONIC=

# HTTP port the faucet listens on.
PORT=8088

# Tendermint RPC endpoint used to broadcast the funding transaction.
LCV_RPC_URL=http://localhost:26657

# Bech32 address prefix.
LCV_BECH32_PREFIX=lcv

# Denom and amount (in that denom's base units) sent per successful request.
# Default: 10 LCV (ulcv has 6 decimals).
FAUCET_DENOM=ulcv
FAUCET_DRIP_AMOUNT=10000000

# How long a single address must wait between successful drips.
FAUCET_ADDRESS_COOLDOWN_MS=86400000

# Per-IP request-rate window and cap (express-rate-limit).
FAUCET_IP_WINDOW_MS=3600000
FAUCET_IP_MAX_REQUESTS=5
